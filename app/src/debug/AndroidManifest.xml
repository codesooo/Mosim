<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
            디버그 빌드 전용. STT가 연동되기 전에 adb로 음성 문장을 넣어 E-2·F-1을 손으로 확인한다.
            보내는 명령은 docs/design/escort.md "디버그용 음성 문장 주입"에 있다.
            adb가 보내야 해서 exported=true다. release 빌드에는 이 파일이 들어가지 않는다.
        -->
        <receiver
            android:name=".debug.DebugSpeechReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.example.mosim.DEBUG_SAY" />
            </intent-filter>
        </receiver>

        <!--
            디버그 빌드 전용. 에뮬레이터에서는 차가 움직이지 않아 도착·정체 신호가 오지 않는다.
            시연과 손 테스트에서 Mock 경로 소스에만 그 사건을 넣는다.
        -->
        <receiver
            android:name=".debug.DebugTripReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.example.mosim.DEBUG_ARRIVE" />
                <action android:name="com.example.mosim.DEBUG_DELAY" />
                <action android:name="com.example.mosim.DEBUG_MOCK_TRIP" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".feature.planrevision.FScreenDemoActivity"
            android:exported="true"
            android:theme="@style/Theme.Mosim" />

        <activity
            android:name=".feature.voice.VoiceDemoActivity"
            android:exported="true"
            android:theme="@style/Theme.Mosim" />

        <activity
            android:name=".feature.voice.SttAudioCheckActivity"
            android:exported="true"
            android:theme="@style/Theme.Mosim" />

        <activity
            android:name=".feature.voice.SttReArmCheckActivity"
            android:exported="true"
            android:theme="@style/Theme.Mosim" />
    </application>

</manifest>